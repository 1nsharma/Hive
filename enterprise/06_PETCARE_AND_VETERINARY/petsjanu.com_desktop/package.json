{
  "name": "@1nsharma/petjanu-app",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "PetJanu — Smart NFC/QR Pet Safety Platform with AI Triage, GPS Tracking, and Payments",
  "author": "1nsharma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1nsharma/Petsjanu.com.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "seo:audit": "node scripts/seo-check.cjs",
    "env:check": "node scripts/validate-env.cjs",
    "branches:sync": "node scripts/sync-all-branches.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "android:sync": "npx cap sync android",
    "android:apk": "node scripts/build-apk.cjs",
    "pre-fix": "npm run type-check && npm run build",
    "check-all": "npm run env:check && npm run type-check && npm run test && npm run build",
    "mcp:runner": "node scripts/mcp-runner.cjs",
    "mcp:test": "node scripts/mcp-runner.cjs --test",
    "mcp:connect": "node scripts/code-connect.cjs",
    "preview": "vite preview",
    "release": "npm run build && npm publish"
  },
  "bin": {
    "petjanu-mcp": "./scripts/mcp-runner.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@codesandbox/sdk": "^2.4.2",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/howler": "^2.2.13",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "howler": "^2.2.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/ios": "^8.5.1",
    "@dyad-sh/react-vite-component-tagger": "^0.9.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
