{
  "appId": "com.petsjanu.app",
  "appName": "PetJanu",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "hostname": "petsjanu.com"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0C3527",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "spinnerColor": "#F0A21E"
    }
  }
}
