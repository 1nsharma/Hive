{
  "name": "dukaanmitra-os",
  "version": "1.0.0",
  "description": "DukaanMitra-OS: Universal Business Management & Multi-Modal AI Operating System for MSMEs",
  "scripts": {
    "launch": "node scripts/start-production.js",
    "dev": "node scripts/start-dev.js",
    "dev:core": "npm --prefix apps/core-engine run dev",
    "dev:ai": "python -m uvicorn app:app --port 8000 --app-dir apps/ai-services",
    "build": "npm --prefix apps/core-engine run build",
    "test": "npm --prefix apps/core-engine test && python apps/ai-services/tests/test_smoke.py && python apps/ai-services/tests/test_vertical_slice.py && python apps/ai-services/tests/test_superintelligence_acceptance.py && python apps/ai-services/tests/test_prelaunch_audit_phase2.py && python apps/ai-services/tests/test_company_and_launch.py && python apps/ai-services/tests/test_dukaanmitra_in_platform.py && python apps/ai-services/tests/test_mowglai_delivery_agent.py && node scripts/validate-deployments.js",
    "test:company": "python apps/ai-services/tests/test_company_and_launch.py",
    "test:audit": "python apps/ai-services/tests/test_prelaunch_audit_phase2.py",
    "test:acceptance": "python apps/ai-services/tests/test_superintelligence_acceptance.py",
    "test:slice": "python apps/ai-services/tests/test_vertical_slice.py",
    "test:core": "npm --prefix apps/core-engine test",
    "test:ai": "python apps/ai-services/tests/test_vertical_slice.py",
    "start": "node apps/core-engine/dist/index.js",
    "test:platform": "python apps/ai-services/tests/test_dukaanmitra_in_platform.py",
    "dev:mitraos": "npm --prefix apps/mitra-os-web run dev",
    "dev:dukaanin": "npm --prefix apps/dukaan-in-next run dev",
    "build:mitraos": "npm --prefix apps/mitra-os-web run build",
    "build:dukaanin": "npm --prefix apps/dukaan-in-next run build",
    "validate:deploy": "node scripts/validate-deployments.js",
    "test:mowglai": "python apps/ai-services/tests/test_mowglai_delivery_agent.py"
  },
  "keywords": [
    "dukaanmitra",
    "mitraconnect",
    "msme",
    "kirana",
    "inventory",
    "ai",
    "multimodal",
    "voice",
    "ocr",
    "compliance",
    "gst",
    "mcp",
    "superintelligence",
    "shared-brain",
    "company-entity",
    "launch-fasttrack"
  ],
  "author": "Amit Sharma / DukaanMitra Team",
  "license": "ISC"
}