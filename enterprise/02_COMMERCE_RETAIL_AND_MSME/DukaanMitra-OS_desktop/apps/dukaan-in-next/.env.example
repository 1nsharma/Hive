# ------------------------------------------------------------------------------
# DUKAANMITRA VERCEL ENVIRONMENT VARIABLES (CHECKLIST)
# ------------------------------------------------------------------------------

# --- 1. FIREBASE CONFIG (Required for Auth & DB) ---
# Find these in Firebase Console > Project Settings > General (Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- 2. GOOGLE AI (Required for AI Munim Brain) ---
# Get this from https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=your_gemini_api_key

# --- 3. RAZORPAY (Required for Subscriptions) ---
# Get these from Razorpay Dashboard > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_for_verification

# --- 4. FIREBASE ADMIN (Required for Server-Side Operations) ---
# Create a Service Account in Firebase Console > Project Settings > Service Accounts
# Then download JSON and paste the ENTIRE content as a single line string here.
# NOTE: In Vercel, use 'applicationDefault' or set this key.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# --- 5. WHATSAPP / META (Required for WhatsApp Messaging) ---
# Get these from Meta for Developers > WhatsApp > Setup
WHATSAPP_API_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_WEBHOOK_SECRET=your_app_secret_from_meta_dashboard

# --- 6. MAILGUN (Required for Contact Form) ---
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.dukaanmitra.in
MAILGUN_FROM_EMAIL=DukaanMitra Support <support@mg.dukaanmitra.in>
CONTACT_EMAIL_RECIPIENT=hello@dukaanmitra.in

# --- 7. SUPABASE (Optional: Auto Ingestion from Vercel API) ---
# Use standard names (recommended)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Compatibility names (if your deployment already uses docs_* keys)
NEXT_PUBLIC_docs_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_docs_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_docs_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

docs_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
docs_SUPABASE_SECRET_KEY=your_secret_key

docs_POSTGRES_DATABASE=postgres
docs_POSTGRES_HOST=db.your-project-ref.supabase.co
docs_POSTGRES_PASSWORD=your_postgres_password
docs_POSTGRES_PRISMA_URL=postgres://...
docs_POSTGRES_URL=postgres://...
docs_POSTGRES_URL_NON_POOLING=postgres://...
docs_POSTGRES_USER=postgres
