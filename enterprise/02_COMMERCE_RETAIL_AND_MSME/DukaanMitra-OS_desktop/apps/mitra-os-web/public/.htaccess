# AI-Optimized Caching & Security Headers Setup (Apache)

# ----------------------------------------------------------------------
# Section 1. Performance optimization (Expires and Cache-Control)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Media caches
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # Scripts and Styles
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Cache immutability for fingerprinted assets in production build (Vite assets)
  <FilesMatch "\.(woff2|woff|ttf|otf|webp|jpeg|png|jpg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000, must-revalidate"
  </FilesMatch>

  # Disable caching for dynamic API, config or html structures
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # ----------------------------------------------------------------------
  # Section 2. Security Headers (CSP, HSTS, COOP, XFO, XXP, RP)
  # ----------------------------------------------------------------------
  
  # Strict Content Security Policy (CSP)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://lh3.googleusercontent.com https://res.cloudinary.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://firebaseinstallations.googleapis.com; frame-src 'self' https://*.firebaseapp.com; object-src 'none';"

  # HTTP Strict Transport Security (HSTS)
  Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Cross-Origin Opener Policy (COOP)
  Header set Cross-Origin-Opener-Policy "same-origin"

  # X-Frame-Options (XFO)
  Header set X-Frame-Options "SAMEORIGIN"

  # X-Content-Type-Options
  Header set X-Content-Type-Options "nosniff"

  # Referrer-Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions-Policy
  Header set Permissions-Policy "camera=self, microphone=self, geolocation=self"
</IfModule>
