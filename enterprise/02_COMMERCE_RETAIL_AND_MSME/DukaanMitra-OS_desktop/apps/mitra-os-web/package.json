{
  "name": "dukaanmitra-mobile-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "node scripts/sync-seo.js && node scripts/generate-sitemap.js && node scripts/generate-llms.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "i18n-audit": "python3 scripts/i18n-checker.py",
    "heading-audit": "node scripts/validate-headings.js",
    "test": "vitest",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.48.0",
    "@tailwindcss/vite": "^4.2.2",
    "@vercel/sandbox": "^1.10.0",
    "animejs": "^3.2.2",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "firebase": "^12.11.0",
    "framer-motion": "^12.40.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "playwright": "^1.61.1",
    "razorpay": "^2.9.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.1.2",
    "react-helmet-async": "^3.0.0",
    "react-is": "^19.2.5",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.8.1",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vercel/node": "^5.8.26",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.4"
  }
}