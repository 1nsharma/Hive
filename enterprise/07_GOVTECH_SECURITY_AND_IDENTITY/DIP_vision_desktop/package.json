{
  "name": "aura-vision-monorepo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Aura v1: Enterprise Edge-First Vision & Evidence-Grounded Search Platform",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
