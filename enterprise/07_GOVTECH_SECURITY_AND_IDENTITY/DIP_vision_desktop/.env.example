# Aura v1 M0 Environment Template (Zero raw credentials)
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://aura_user:aura_password@localhost:5432/aura_dev

# JWT & Auth
JWT_SIGNING_KEY=temporary-dev-signing-key-replace-in-secret-manager-min32chars
JWT_EXPIRATION_SECONDS=900
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Observability
SERVICE_NAME=aura-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
